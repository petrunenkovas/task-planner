{
    "name": "task-planner",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "tsc --noEmit && vite build",
        "test": "tsx --test tests/*.test.ts",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,md,yaml}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,ts,md,yaml}\""
    },
    "dependencies": {
        "@dnd-kit/dom": "0.5.0",
        "@dnd-kit/react": "0.5.0",
        "@svar-ui/core-locales": "2.6.1",
        "@svar-ui/gantt-store": "2.7.2",
        "@svar-ui/react-core": "2.6.1",
        "@svar-ui/react-gantt": "2.7.3",
        "@tanstack/react-query": "5.104.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-router": "8.4.0",
        "zod": "4.6.5"
    },
    "devDependencies": {
        "@types/node": "26.6.3",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.1",
        "prettier": "3.9.4",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vite": "8.3.1"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
